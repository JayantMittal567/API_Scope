# ==============================================================================
# ApiScope 1.0 — Environment Configuration Template (.env.example)
#
# Copy this file to .env and customize as needed.
# ApiScope operates completely offline by default; external API keys are optional.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL: AI-Assisted Test Planning & Generation (Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Leave empty for 100% offline rule-based generation and deterministic test planning.
# ApiScope is free-tier aware with deterministic caching and strict token budget enforcement.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI provider fallback
OPENAI_API_KEY=

# Unified provider key alternative
# APISCOPE_LLM_API_KEY=

# ------------------------------------------------------------------------------
# 2. EXECUTION SAFETY & TARGET ISOLATION
# ------------------------------------------------------------------------------
# Default mode is READ_ONLY. Permitted values: READ_ONLY, PERMIT_MUTATIONS, PERMIT_ALL
APISCOPE_EXECUTION_MODE=READ_ONLY
APISCOPE_ALLOW_MUTATIONS=false
APISCOPE_ALLOW_DESTRUCTIVE=false

# Target Access Policy (SSRF guardrails)
# When false, requests to loopback (127.0.0.1) and private IPs are blocked unless whitelisted.
APISCOPE_ALLOW_PRIVATE_NETWORKS=false
APISCOPE_ALLOWED_TARGET_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ------------------------------------------------------------------------------
# 3. WEB DASHBOARD CONFIGURATION
# ------------------------------------------------------------------------------
APISCOPE_HOST=127.0.0.1
APISCOPE_PORT=8000
APISCOPE_DB_PATH=.apiscope/history.db
APISCOPE_OUTPUT_DIR=.apiscope

# HMAC secret key used for CSRF token generation on state-changing dashboard actions
APISCOPE_CSRF_SECRET=apiscope-local-dashboard-csrf-secret-change-in-production
