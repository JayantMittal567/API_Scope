# ApiScope Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Environment (development, testing, production)
APISCOPE_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
APISCOPE_LOG_LEVEL=INFO

# Web Dashboard Server Configuration
APISCOPE_HOST=127.0.0.1
APISCOPE_PORT=8000

# SQLite Persistence Configuration
APISCOPE_DB_PATH=apiscope.db

# HTTP Request Execution Defaults
APISCOPE_REQUEST_TIMEOUT=30
